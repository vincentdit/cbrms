{
  "realm": "tirdo",
  "displayName": "TIRDO",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "BILLING_OFFICER",
        "description": "Prepares bills, change requests and refunds; records refund execution"
      },
      {
        "name": "BILL_APPROVER",
        "description": "Approves bills, cancellations, expiry changes and refunds (second officer)"
      },
      {
        "name": "FINANCE_VIEWER",
        "description": "Read-only Finance access; changes nothing"
      },
      {
        "name": "PLATFORM",
        "description": "Machine role for source platforms such as LIMS"
      },
      {
        "name": "TECHNICAL_OPERATOR",
        "description": "ICTT operations: monitoring endpoints"
      },
      {
        "name": "AUDITOR",
        "description": "Internal Audit: reads every Finance view and the audit trail; changes nothing"
      }
    ]
  },
  "clients": [
    {
      "clientId": "cbrms-console",
      "name": "CBRMS Finance console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8086/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+",
        "minimum.acr.value": "mfa",
        "default.acr.values": "mfa"
      },
      "protocolMappers": [
        {
          "name": "cbrms-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "cbrms",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
